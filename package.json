{
  "name": "msalem-library",
  "version": "1.0.0",
  "description": "Library Management System for M-Salem",
  "author": "M-Salem",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"cd app && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "app-build": "cd app && npm run build",
    "dist": "npm run app-build && electron-builder"
  },
  "build": {
    "appId": "com.msalem.library",
    "productName": "M'Salem Library",
    "directories": {
      "app": ".",
      "output": "dist_installer"
    },
    "files": [
      "main/**/*",
      "app/dist/**/*",
      "package.json",
      "!backend/**/*",
      "!app/node_modules/**/*",
      "!app/package.json",
      "!app/src/**/*",
      "!app/public/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          ".env",
          "!*.log",
          "!data/**/*"
        ]
      },
      {
        "from": "app/public/icon.ico",
        "to": "assets/icon.ico"
      },
      {
        "from": "app/public/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "asar": true,
    "win": {
      "icon": "app/public/icon.ico",
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "M'Salem Library"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nedb-promises": "^6.2.3",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.3"
  }
}
